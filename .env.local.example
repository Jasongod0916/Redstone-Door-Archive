NEXT_PUBLIC_SUPABASE_URL=<YOUR_SUPABASE_URL>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>

# 3D viewer assets. Defaults below serve from public/vendor/ — run
# `bun run setup:vendor` once to download them (~30 MB, gitignored).
# Three is loaded as an ES module and attached to window.THREE at
# runtime; the schematic-renderer UMD reads it from there.
NEXT_PUBLIC_THREE_URL=/vendor/three.module.min.js
NEXT_PUBLIC_SCHEMATIC_RENDERER_URL=/vendor/schematic-renderer.umd.js
