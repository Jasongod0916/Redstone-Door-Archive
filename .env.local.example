NEXT_PUBLIC_SUPABASE_URL=<YOUR_SUPABASE_URL>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>

# Optional: self-host the Three.js + schematic-renderer UMD bundles instead of
# hitting unpkg. Drop the files under public/vendor/ and point these here.
# NEXT_PUBLIC_THREE_URL=/vendor/three.min.js
# NEXT_PUBLIC_SCHEMATIC_RENDERER_URL=/vendor/schematic-renderer.umd.js
