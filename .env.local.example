NEXT_PUBLIC_SUPABASE_URL=<YOUR_SUPABASE_URL>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>

# 3D viewer assets. Defaults below serve from public/vendor/ — run
# `bun run setup:vendor` once to download them (~30 MB, gitignored).
# Override to a CDN URL if you don't want to self-host.
NEXT_PUBLIC_THREE_URL=/vendor/three.min.js
NEXT_PUBLIC_SCHEMATIC_RENDERER_URL=/vendor/schematic-renderer.umd.js
